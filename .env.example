# Copie ce fichier en .env et remplis les valeurs. Ne publie jamais le .env !
DISCORD_TOKEN=COLLE_ICI_LE_TOKEN_DU_BOT
DISCORD_CHANNEL_ID=123456789012345678
POLL_MINUTES=15
# vide = toutes les sources, sinon par ex : USD,EUR,GBP,JPY,CAD,CHF,XAU,OIL
CURRENCIES=
# 1 = ne publier que les news à impact élevé (taux, inflation, emploi, PIB...)
ONLY_HIGH_IMPACT=0
# les news plus vieilles que ce nombre d'heures ne sont pas publiées
MAX_AGE_HOURS=48
